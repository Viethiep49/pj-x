# Copy this file to .env.local and fill values with your own credentials.
# DO NOT commit real secrets to version control.

# Vite client IDs for OAuth providers (used by the frontend only).
VITE_GOOGLE_CLIENT_ID=your-google-client-id
VITE_FACEBOOK_APP_ID=1284946620213096

# Example: VITE_FACEBOOK_APP_ID=123456789012345
# If you have a server-side access token, keep it ONLY on your backend; do not store it here.
