# Backend Environment Variables for Pawsitive Pet Spa
# Copy this to .env and edit values

PORT=5001
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pet_grooming
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here  # ⚠️ CHANGE THIS to your PostgreSQL password
JWT_SECRET=your_super_secret_jwt_key_here  # Generate: openssl rand -hex 32
AICORE_URL=http://localhost:8000
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_app_password

