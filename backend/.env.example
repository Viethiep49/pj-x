PORT=5001
NODE_ENV=development

# Database PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pet_grooming
DB_USER=postgres
DB_PASSWORD=123

# JWT (đặt bất kỳ chuỗi ngẫu nhiên dài)
JWT_SECRET=change-this-to-a-long-random-secret-string
JWT_EXPIRES_IN=7d

# URL của Frontend (CORS)
CLIENT_URL=http://localhost:5173

# URL của AI Core (tuỳ chọn)
AICORE_URL=http://localhost:8000

# Email SMTP (tuỳ chọn - dùng để gửi hóa đơn)
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_gmail_app_password

GOOGLE_CLIENT_ID=
GOOGLE_CLIENTSECRET=